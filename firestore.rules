rules_version = '2';

// ============================================================
// QUINIELA NFL 2026 — Reglas de Firestore
// ------------------------------------------------------------
// Cárgalas en: Firebase Console > Firestore Database > Reglas
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return estaAutenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }

    function esDueno(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    function aunAbierto(partidoId) {
      let partido = get(/databases/$(database)/documents/partidos/$(partidoId)).data;
      // Además: en cuanto se publica el Pronóstico Semanal de esa semana
      // (al cierre), ya no se puede capturar ni cambiar ningún pick de la semana.
      return request.time < (partido.fechaHora - duration.value(5, 'm'))
        && !exists(/databases/$(database)/documents/pronosticoSemanal/$('semana_' + string(partido.semana)));
    }

    match /stats/public {
      allow read: if true;
      allow write: if false;
    }

    match /solicitudes/{id} {
      allow create: if request.resource.data.estado == "pendiente";
      allow read: if esAdmin();
      allow update, delete: if esAdmin();
    }

    match /usuarios/{uid} {
      allow create: if false;
      allow read: if esDueno(uid) || esAdmin();
      allow update: if esAdmin() ||
                    (esDueno(uid)
                      && request.resource.data.rol == resource.data.rol
                      && request.resource.data.puntosTotales == resource.data.puntosTotales);
      allow delete: if esAdmin();
    }

    match /partidos/{partidoId} {
      allow read: if estaAutenticado();
      allow write: if esAdmin();
    }

    match /tabla/{uid} {
      allow read: if estaAutenticado();
      allow write: if false;
    }

    match /resultadosSemana/{semana} {
      allow read: if estaAutenticado();
      allow write: if false;
    }

    match /puntosSemana/{id} {
      allow read: if estaAutenticado();
      allow write: if false;
    }

    // Vaciado público de picks de la semana; lo escribe solo la Cloud Function
    // publicarPronosticoSemanal (Admin SDK) al cierre de cada semana.
    match /pronosticoSemanal/{semanaId} {
      allow read: if estaAutenticado();
      allow write: if false;
    }

    match /pronosticos/{pronosticoId} {
      allow read: if esAdmin()
                  || (estaAutenticado()
                      && (resource == null || resource.data.usuarioId == request.auth.uid));
      allow create: if estaAutenticado()
                    && request.resource.data.usuarioId == request.auth.uid
                    && aunAbierto(request.resource.data.partidoId);
      allow update: if esAdmin()
                    || (estaAutenticado()
                        && resource.data.usuarioId == request.auth.uid
                        && aunAbierto(resource.data.partidoId));
      allow delete: if esAdmin();
    }
  }
}
