# Copia este archivo a functions/.env y llena los valores reales.
# Las variables SECRETAS (SENDGRID_API_KEY, APPROVAL_SECRET) NO van aquí:
# se configuran con `firebase functions:secrets:set` (ver README).

# Correo remitente verificado en SendGrid (Single Sender o dominio autenticado)
FROM_EMAIL=quiniela@tudominio.com

# URL pública del sitio publicado en GitHub Pages (sin / al final)
APP_BASE_URL=https://tu-usuario.github.io/tu-repo
